<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Car Meets Denmark{% endblock %}</title>
    <link rel="icon" href="{{ asset('wheel.png') }}">

    {# Tailwind CSS for web platform #}
    <link rel="stylesheet" href="{{ asset('styles/web.css') }}">

    {# MapTiler SDK for map pages #}
{#    <link rel="stylesheet" href="https://cdn.maptiler.com/maptiler-sdk-js/v1.2.0/maptiler-sdk.css">#}

    {% block stylesheets %}{% endblock %}
    {% block head %}{% endblock %}
</head>
<body class="h-full bg-neutral-light text-primary-text font-inter" data-controller="turbo-error-handler">
{% import '_icons.html.twig' as icons %}

{% set pageTitle %}{% block page_title %}{% endblock %}{% endset %}
{% set pageTitle = pageTitle|trim ?: block('title') %}

{% set backUrl %}{% block back_url %}{% endblock %}{% endset %}
{% set backUrl = backUrl|trim %}

{% if app.user %}
    {% import 'user/_macros.html.twig' as userMacros %}
    {# === Mobile topbar (visible <lg) === #}
    <header class="mobile-topbar">
        {% if backUrl %}
            <a href="{{ backUrl }}" class="inline-flex items-center justify-center w-9 h-9 -ml-2 text-primary-text" aria-label="Back">
                {{ icons.chevronLeft({size: 22}) }}
            </a>
        {% endif %}
        <h1 class=" {{ backUrl ? 'text-center' : 'text-left' }}">
            {{ pageTitle }}
        </h1>
        {% set unreadCount = unread_notification_count() %}
        <button type="button"
                class="relative inline-flex items-center justify-center w-9 h-9 mr-1 text-primary-text"
                data-controller="notification-bell"
                data-action="click->notification-bell#toggle"
                data-notification-bell-url-value="{{ path('app_notification_dropdown') }}"
                aria-label="Notifications">
            {{ icons.bell({size: 22}) }}
            {% if unreadCount > 0 %}
                <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] rounded-full bg-error text-white text-xs font-semibold flex items-center justify-center px-1"
                      data-notification-bell-target="badge">
                    {{ unreadCount > 99 ? '99+' : unreadCount }}
                </span>
            {% endif %}
        </button>
        <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}" class="user-avatar !w-9 !h-9 overflow-hidden" aria-label="Your profile">
            {% if app.user.avatarFilename %}
                <img src="{{ userMacros.avatar_url(app.user) }}" alt="{{ app.user.name|default('') }}" class="w-full h-full object-cover">
            {% else %}
                {{ app.user.name|slice(0,1)|upper }}{{ app.user.name|split(' ')|last|slice(0,1)|upper }}
            {% endif %}
        </a>
    </header>

    {# === Mobile bottom nav (visible <lg) === #}
    <nav class="mobile-bottombar lg:hidden fixed bottom-0 inset-x-0 z-30 bg-black text-white" aria-label="Primary">
        <div class="grid grid-cols-4 h-16">
            {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
            <a href="{{ path('app_discover') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.dashboard({size: 22}) }}
                <span class="text-xs">Discover</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>

            {% set isActive = app.request.attributes.get('_route') == 'app_event_index' %}
            <a href="{{ path('app_event_index') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.location({size: 22}) }}
                <span class="text-xs">Your events</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>

            {% set isActive = app.request.attributes.get('_route') starts with 'app_team_' %}
            <a href="{{ path('app_team_index') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.teams({size: 22}) }}
                <span class="text-xs">Teams</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>

            {% set isActive = app.request.attributes.get('_route') starts with 'app_heatmap' %}
            <a href="{{ path('app_heatmap_index') }}" data-turbo="false" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.flame({size: 22}) }}
                <span class="text-xs">Hotspots</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>
        </div>
    </nav>

    {# === Desktop === #}
    <div class="app-layout">
        {# Sidebar — desktop only #}
        <aside class="sidebar-card hidden lg:flex">
            <div class="sidebar-header">
                <a href="{{ path('app_discover') }}" class="sidebar-logo">
                    <img src="{{ asset('wheel.png') }}" alt="Carmeets Denmark">
                    Carmeets Denmark
                </a>
            </div>

            <nav class="sidebar-nav">
                {# Main navigation #}
                <div class="sidebar-section">
                    {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
                    <a href="{{ path('app_discover') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.dashboard() }}
                        <span>Discover</span>
                    </a>
                    {% set isActive = app.request.attributes.get('_route') == 'app_event_index' %}
                    <a href="{{ path('app_event_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.location() }}
                        <span>Events</span>
                    </a>
                    {% set isActive = app.request.attributes.get('_route') starts with 'app_team_' %}
                    <a href="{{ path('app_team_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.teams() }}
                        <span>Teams</span>
                    </a>
                    {% set isActive = app.request.attributes.get('_route') starts with 'app_heatmap' %}
                    <a href="{{ path('app_heatmap_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}" data-turbo="false">
                        {{ icons.flame({size: 20}) }}
                        <span>Hotspots</span>
                    </a>
                </div>

                {% if is_support_mode() %}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Support</div>
                        {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
                        <a href="{{ path('app_discover') }}"
                           class="sidebar-link {{ isActive ? 'active' : '' }}">
                            {{ icons.dashboard() }}
                            <span>Pours</span>
                        </a>
                    </div>
                {% endif %}

                {# Spacer #}
                <div class="sidebar-spacer"></div>

                {# Bottom section #}
                <div class="sidebar-section">
                    {% set isActive = app.request.attributes.get('_route') == 'app_user_show' %}
                    <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.person() }}
                        <span>Profile</span>
                    </a>
                    <a href="{{ path('app_settings') }}" class="sidebar-link {{ app.request.attributes.get('_route') == 'app_settings' ? 'active' : '' }}" data-turbo="false">
                        {{ icons.settings() }}
                        <span>Settings</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="sidebar-link" data-turbo="false">
                        {{ icons.logout() }}
                        <span>Logout</span>
                    </a>
                </div>
            </nav>
        </aside>

        {# Main content #}
        <div class="main-wrapper">
            {# Desktop topbar, desktop only #}
            <header class="topbar-card hidden lg:block">
                <div class="topbar-content">
                    <div class="topbar-left">
                        {# Support mode indicator #}
                        {% if is_support_mode() %}
                            <div class="support-mode-badge" role="status"
                                 aria-label="Support mode active - viewing all pours">
                                {{ icons.shield({size: 14}) }}
                                <span>Support</span>
                            </div>
                        {% endif %}
                    </div>
                    <div class="topbar-right">
                        {% set unreadCount = unread_notification_count() %}
                        <button type="button"
                                class="relative inline-flex items-center justify-center w-10 h-10 mr-2 text-primary-text"
                                data-controller="notification-bell"
                                data-action="click->notification-bell#toggle"
                                data-notification-bell-url-value="{{ path('app_notification_dropdown') }}"
                                aria-label="Notifications">
                            {{ icons.bell({size: 22}) }}
                            {% if unreadCount > 0 %}
                                <span class="absolute top-1 right-1 min-w-[18px] h-[18px] rounded-full bg-error text-white text-xs font-semibold flex items-center justify-center px-1"
                                      data-notification-bell-target="badge">
                                    {{ unreadCount > 99 ? '99+' : unreadCount }}
                                </span>
                            {% endif %}
                        </button>
                        <div class="user-info">
                            <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}" class="user-avatar overflow-hidden" aria-label="Your profile">
                                {% if app.user.avatarFilename %}
                                    <img src="{{ userMacros.avatar_url(app.user) }}" alt="{{ app.user.name|default('') }}" class="w-full h-full object-cover">
                                {% else %}
                                    {{ app.user.name|slice(0,1)|upper }}{{ app.user.name|split(' ')|last|slice(0,1)|upper }}
                                {% endif %}
                            </a>
                            <div class="user-details">
                                <div class="user-name">{{ app.user.name }}</div>
                                <div class="user-email">{{ app.user.email }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            {# Main content area — top/bottom padding on mobile to clear the fixed bars #}
            <main class="content-card">
                {% for message in app.flashes('success') %}
                    <div class="alert-success" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert-error" role="alert">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    <div id="toast-container" data-turbo-permanent></div>

    <twig:Modal:Shell/>
{% else %}
    {# Non-authenticated layout (login pages) #}
    <main class="min-h-full flex items-center justify-center py-12 px-4 bg-neutral">
        {{ block('body') }}
    </main>
{% endif %}

{% block javascripts %}
    {{ importmap('web') }}
{% endblock %}
</body>
</html>
