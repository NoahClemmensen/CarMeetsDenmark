<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Spoked{% endblock %}</title>
    <link rel="icon" href="{{ asset('wheel.png') }}">

    {# Tailwind CSS for web platform #}
    <link rel="stylesheet" href="{{ asset('styles/web.css') }}">

    {# MapTiler SDK for map pages #}
{#    <link rel="stylesheet" href="https://cdn.maptiler.com/maptiler-sdk-js/v1.2.0/maptiler-sdk.css">#}

    {% block stylesheets %}{% endblock %}
    {% block head %}{% endblock %}
</head>
<body class="h-full bg-neutral-light text-primary-text font-inter"
      data-controller="turbo-error-handler login-prompt"
      data-login-prompt-login-url-value="{{ path('app_login') }}"
      data-login-prompt-register-url-value="{{ path('app_register') }}">
{% import '_icons.html.twig' as icons %}

{% set pageTitle %}{% block page_title %}{% endblock %}{% endset %}
{% set pageTitle = pageTitle|trim ?: block('title') %}

{% set backUrl %}{% block back_url %}{% endblock %}{% endset %}
{% set backUrl = backUrl|trim %}

{% set backLabel %}{% block back_label %}{% endblock %}{% endset %}
{% set backLabel = backLabel|trim ?: 'nav.back'|trans %}

{% import 'user/_macros.html.twig' as userMacros %}
{# === Mobile topbar (visible <lg) === #}
    <header class="mobile-topbar">
        {% if backUrl %}
            <a href="{{ backUrl }}" class="inline-flex items-center justify-center w-9 h-9 -ml-2 text-primary-text" aria-label="{{ 'nav.back'|trans }}">
                {{ icons.chevronLeft({size: 22}) }}
            </a>
        {% endif %}
        <h1 class=" {{ backUrl ? 'text-center' : 'text-left' }}">
            {{ pageTitle }}
        </h1>
        {# Donation entry point: topbar button (mobile) #}
        {% include '_donation/_topbar_button.html.twig' %}
        {% if app.user %}
            {% set unreadCount = unread_notification_count() %}
            <button type="button"
                    class="relative inline-flex items-center justify-center w-9 h-9 mr-1 text-primary-text"
                    data-controller="notification-bell"
                    data-action="click->notification-bell#toggle"
                    data-notification-bell-url-value="{{ path('app_notification_dropdown') }}"
                    aria-label="{{ 'nav.notifications'|trans }}">
                {{ icons.bell({size: 22}) }}
                {% if unreadCount > 0 %}
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] rounded-full bg-error text-white text-xs font-semibold flex items-center justify-center px-1"
                          data-notification-bell-target="badge">
                        {{ unreadCount > 99 ? '99+' : unreadCount }}
                    </span>
                {% endif %}
            </button>
            <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}" class="user-avatar !w-9 !h-9 overflow-hidden" aria-label="{{ 'nav.your_profile'|trans }}">
                {% if app.user.avatarFilename %}
                    <img src="{{ userMacros.avatar_url(app.user) }}" alt="{{ app.user.name|default('') }}" class="w-full h-full object-cover">
                {% else %}
                    {{ app.user.name|slice(0,1)|upper }}{{ app.user.name|split(' ')|last|slice(0,1)|upper }}
                {% endif %}
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-cta-sm shrink-0" data-turbo="false">{{ 'auth.log_in'|trans }}</a>
        {% endif %}
    </header>

    {# === Mobile bottom nav (visible <lg) === #}
    <nav class="mobile-bottombar lg:hidden fixed bottom-0 inset-x-0 z-30 bg-black text-white" aria-label="{{ 'nav.primary_aria'|trans }}">
        <div class="grid {{ app.user ? 'grid-cols-4' : 'grid-cols-3' }} h-16">
            {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
            <a href="{{ path('app_discover') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.dashboard({size: 22}) }}
                <span class="text-xs">{{ 'nav.discover'|trans }}</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>

            {% if app.user %}
                {% set isActive = app.request.attributes.get('_route') == 'app_event_index' %}
                <a href="{{ path('app_event_index') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                    {{ icons.location({size: 22}) }}
                    <span class="text-xs">{{ 'nav.your_events'|trans }}</span>
                    <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
                </a>
            {% endif %}

            {% set isActive = app.request.attributes.get('_route') starts with 'app_team_' %}
            <a href="{{ path('app_team_index') }}" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.teams({size: 22}) }}
                <span class="text-xs">{{ 'nav.teams'|trans }}</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>

            {% set isActive = app.request.attributes.get('_route') starts with 'app_heatmap' %}
            <a href="{{ path('app_heatmap_index') }}" data-turbo="false" class="mobile-bottombar-link relative flex flex-col items-center justify-center gap-1 {{ isActive ? 'is-active' : '' }}">
                {{ icons.flame({size: 22}) }}
                <span class="text-xs">{{ 'heatmap.title'|trans }}</span>
                <span class="mobile-bottombar-indicator absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 w-8 bg-primary {{ isActive ? '' : 'opacity-0' }}" aria-hidden="true"></span>
            </a>
        </div>
    </nav>

    {# === Desktop === #}
    <div class="app-layout">
        {# Sidebar, desktop only #}
        <aside class="sidebar-card hidden lg:flex">
            <div class="sidebar-header">
                <a href="{{ path('app_discover') }}" class="sidebar-logo">
                    <img src="{{ asset('wheel.png') }}" alt="Spoked">
                    Spoked
                </a>
            </div>

            <nav class="sidebar-nav">
                {# Main navigation #}
                <div class="sidebar-section">
                    {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
                    <a href="{{ path('app_discover') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.dashboard() }}
                        <span>{{ 'nav.discover'|trans }}</span>
                    </a>
                    {% if app.user %}
                        {% set isActive = app.request.attributes.get('_route') == 'app_event_index' %}
                        <a href="{{ path('app_event_index') }}"
                           class="sidebar-link {{ isActive ? 'active' : '' }}">
                            {{ icons.location() }}
                            <span>{{ 'nav.events'|trans }}</span>
                        </a>
                    {% endif %}
                    {% set isActive = app.request.attributes.get('_route') starts with 'app_team_' %}
                    <a href="{{ path('app_team_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.teams() }}
                        <span>{{ 'nav.teams'|trans }}</span>
                    </a>
                    {% set isActive = app.request.attributes.get('_route') starts with 'app_heatmap' %}
                    <a href="{{ path('app_heatmap_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}" data-turbo="false">
                        {{ icons.flame({size: 20}) }}
                        <span>{{ 'heatmap.title'|trans }}</span>
                    </a>
                    {# Donation entry point: sidebar link #}
                    {% include '_donation/_sidebar_link.html.twig' %}
                </div>

                {% if is_support_mode() %}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">{{ 'nav.support'|trans }}</div>
                        {% set isActive = app.request.attributes.get('_route') == 'app_discover' %}
                        <a href="{{ path('app_discover') }}"
                           class="sidebar-link {{ isActive ? 'active' : '' }}">
                            {{ icons.dashboard() }}
                            <span>{{ 'nav.pours'|trans }}</span>
                        </a>
                    </div>
                {% endif %}

                {# Spacer #}
                <div class="sidebar-spacer"></div>

                {# Bottom section #}
                {% if app.user %}
                    <div class="sidebar-section">
                        {% set isActive = app.request.attributes.get('_route') == 'app_user_show' %}
                        <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}"
                           class="sidebar-link {{ isActive ? 'active' : '' }}">
                            {{ icons.person() }}
                            <span>{{ 'nav.profile'|trans }}</span>
                        </a>
                        <a href="{{ path('app_settings') }}" class="sidebar-link {{ app.request.attributes.get('_route') == 'app_settings' ? 'active' : '' }}" data-turbo="false">
                            {{ icons.settings() }}
                            <span>{{ 'nav.settings'|trans }}</span>
                        </a>
                        <a href="{{ path('app_logout') }}" class="sidebar-link" data-turbo="false">
                            {{ icons.logout() }}
                            <span>{{ 'nav.logout'|trans }}</span>
                        </a>
                    </div>
                {% else %}
                    {# Guest CTA: turns the freed space into a signup driver #}
                    <div class="sidebar-section">
                        <div class="card p-4 text-center">
                            <p class="text-sm font-semibold text-primary-text m-0">{{ 'nav.guest_cta.title'|trans }}</p>
                            <p class="text-xs text-secondary-text mt-1 mb-3">{{ 'nav.guest_cta.subtitle'|trans }}</p>
                            <a href="{{ path('app_register') }}" class="btn-cta w-full justify-center" data-turbo="false">{{ 'auth.sign_up'|trans }}</a>
                            <a href="{{ path('app_login') }}" class="btn-secondary-sm w-full justify-center mt-2" data-turbo="false">{{ 'auth.log_in'|trans }}</a>
                        </div>
                    </div>
                {% endif %}

                {# Donation entry point: sidebar CTA card #}
                <div class="sidebar-section">
                    {% include '_donation/_sidebar_card.html.twig' %}
                </div>
            </nav>
        </aside>

        {# Main content #}
        <div class="main-wrapper">
            {# Desktop topbar, desktop only #}
            <header class="topbar-card hidden lg:block">
                <div class="topbar-content">
                    <div class="topbar-left">
                        {# Support mode indicator #}
                        {% if is_support_mode() %}
                            <div class="support-mode-badge" role="status"
                                 aria-label="{{ 'nav.support_mode_aria'|trans }}">
                                {{ icons.shield({size: 14}) }}
                                <span>{{ 'nav.support'|trans }}</span>
                            </div>
                        {% endif %}
                    </div>
                    <div class="topbar-right">
                        {# Donation entry point: topbar button (desktop) #}
                        {% include '_donation/_topbar_button.html.twig' %}
                        {% if app.user %}
                            {% set unreadCount = unread_notification_count() %}
                            <button type="button"
                                    class="relative inline-flex items-center justify-center w-10 h-10 mr-2 text-primary-text"
                                    data-controller="notification-bell"
                                    data-action="click->notification-bell#toggle"
                                    data-notification-bell-url-value="{{ path('app_notification_dropdown') }}"
                                    aria-label="{{ 'nav.notifications'|trans }}">
                                {{ icons.bell({size: 22}) }}
                                {% if unreadCount > 0 %}
                                    <span class="absolute top-1 right-1 min-w-[18px] h-[18px] rounded-full bg-error text-white text-xs font-semibold flex items-center justify-center px-1"
                                          data-notification-bell-target="badge">
                                        {{ unreadCount > 99 ? '99+' : unreadCount }}
                                    </span>
                                {% endif %}
                            </button>
                            <div class="user-info">
                                <a href="{{ path('app_user_show', {uuid: app.user.uuid}) }}" class="user-avatar overflow-hidden" aria-label="{{ 'nav.your_profile'|trans }}">
                                    {% if app.user.avatarFilename %}
                                        <img src="{{ userMacros.avatar_url(app.user) }}" alt="{{ app.user.name|default('') }}" class="w-full h-full object-cover">
                                    {% else %}
                                        {{ app.user.name|slice(0,1)|upper }}{{ app.user.name|split(' ')|last|slice(0,1)|upper }}
                                    {% endif %}
                                </a>
                                <div class="user-details">
                                    <div class="user-name">{{ app.user.name }}</div>
                                    <div class="user-email">{{ app.user.email }}</div>
                                </div>
                            </div>
                        {% else %}
                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_login') }}" class="btn-secondary-sm" data-turbo="false">{{ 'auth.log_in'|trans }}</a>
                                <a href="{{ path('app_register') }}" class="btn-cta-sm" data-turbo="false">{{ 'auth.sign_up'|trans }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </header>

            {# Main content area, top/bottom padding on mobile to clear the fixed bars #}
            <main class="content-card">
                {# Desktop back link, mobile uses the topbar chevron instead #}
                {% if backUrl %}
                    <a href="{{ backUrl }}"
                       class="hidden lg:inline-flex items-center gap-1.5 text-sm font-medium text-secondary-text hover:text-primary-text transition-colors no-underline mb-4">
                        {{ icons.chevronLeft({size: 18}) }}
                        <span>{{ backLabel }}</span>
                    </a>
                {% endif %}
                {% for message in app.flashes('success') %}
                    <div class="alert-success" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert-error" role="alert">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    <div id="toast-container" data-turbo-permanent></div>

    <twig:Modal:Shell/>

{% include '_js_translations.html.twig' %}

{% block javascripts %}
    {{ importmap('web') }}
{% endblock %}
</body>
</html>
