<div
    id="app-modal"
    data-turbo-permanent
    data-controller="modal"
    data-modal-close-on-escape-value="true"
    data-modal-close-on-backdrop-value="true"
    class="modal"
    aria-hidden="true"
>
    <div class="modal__backdrop" data-modal-target="backdrop" data-action="click->modal#backdropClick"></div>

    <div class="modal__dialog" data-modal-target="dialog" role="dialog" aria-modal="true" aria-label="Dialog" aria-labelledby="modal-title">
        <div id="modal-header" data-modal-target="header"></div>
        <div id="modal-body" data-modal-target="body"></div>
        <div id="modal-footer" data-modal-target="footer">
            <div id="modal-flashes"></div>
        </div>
    </div>
</div>
