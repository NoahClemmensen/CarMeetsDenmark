{% extends 'base.html.twig' %}
{% import 'team/_macros.html.twig' as teamMacros %}

{% block title %}Teams{% endblock %}

{% block body %}
    <div class="w-full max-w-3xl">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-semibold m-0">Teams</h2>
            {% if app.user %}
                <a class="btn-cta" href="{{ path('app_team_save') }}">Create team</a>
            {% endif %}
        </div>

        {% if teams is empty %}
            <div class="card p-8 text-center text-secondary-text">
                No teams yet.
            </div>
        {% else %}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {% for team in teams %}
                    <a href="{{ path('app_team_show', {uuid: team.uuid}) }}" class="card overflow-hidden hover:shadow">
                        <img src="{{ teamMacros.banner_url(team) }}" alt="{{ team.name }}" class="w-full h-28 object-cover">
                        <div class="p-4 flex items-center gap-3">
                            <img src="{{ teamMacros.profile_picture_url(team) }}" alt="" class="w-10 h-10 rounded-full object-cover">
                            <div>
                                <div class="font-semibold">{{ team.name }}</div>
                                <div class="text-sm text-secondary-text">{{ team.members|length }} members</div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
