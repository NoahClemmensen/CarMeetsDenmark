{% extends 'components/Modal/ContentShell.html.twig' %}

{% block header %}
    <twig:Modal:Header title="{{ 'team.delete.title'|trans }}" />
{% endblock %}

{% block body %}
    <div class="px-6 py-4">
        <p class="text-sm text-primary-text">
            {{ 'team.delete.body_prefix'|trans }} <strong>{{ team.name }}</strong>{{ 'team.delete.body_suffix'|trans }}
        </p>
    </div>
{% endblock %}

{% block footer %}
    <div class="modal-footer">
        <button type="button" class="btn-grey" data-action="click->modal#hide">{{ 'common.cancel'|trans }}</button>
        <form method="POST"
              action="{{ path('app_team_delete', {uuid: team.uuid}) }}"
              class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('team-delete-' ~ team.uuid) }}">
            <button type="submit" class="btn-danger">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
