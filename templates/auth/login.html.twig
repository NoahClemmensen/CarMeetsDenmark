{% extends 'base_public.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }} - Spoked{% endblock %}

{% block body %}
    <div class="h-full w-full flex justify-center items-center">
        <div class="card p-8 max-w-md">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-semibold text-on-surface mb-2">{{ 'auth.welcome_heading'|trans }}</h1>
                <p class="text-on-surface-var">{{ 'auth.login.subtitle'|trans }}</p>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert-error" role="alert">{{ message }}</div>
            {% endfor %}
            {% if error %}
                <div class="alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" data-turbo="false" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label for="username" class="form-label">{{ 'auth.email_label'|trans }}</label>
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        class="form-input"
                        placeholder="you@example.com"
                        value="{{ last_username }}"
                        required
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">{{ 'auth.password_label'|trans }}</label>
                    <input type="password" id="password" name="_password" required class="form-input" placeholder="{{ 'auth.login.password_placeholder'|trans }}" autocomplete="current-password" />
                </div>

                <button type="submit" class="btn-cta w-full justify-center">
                    {{ 'auth.login.submit'|trans }}
                </button>
            </form>

            <p class="text-sm text-on-surface-var text-center mt-6">
                {{ 'auth.login.no_account_prefix'|trans }} <a class="underline" href="{{ path('app_register') }}">{{ 'common.here'|trans }}</a>.
            </p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}{% endblock %}
