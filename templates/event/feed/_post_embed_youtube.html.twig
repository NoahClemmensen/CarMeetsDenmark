<div class="mt-3 aspect-video rounded-element overflow-hidden">
    <iframe class="w-full h-full"
            src="https://www.youtube.com/embed/{{ post.embedExternalId }}"
            title="{{ 'event.post.youtube_title'|trans }}"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
</div>
