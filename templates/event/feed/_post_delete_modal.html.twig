{% extends 'components/Modal/ContentShell.html.twig' %}

{% block header %}
    <twig:Modal:Header title="{{ 'event.post.delete_title'|trans }}" />
{% endblock %}

{% block body %}
    <div class="px-6 py-4">
        <p class="text-sm text-primary-text">
            {{ 'event.post.delete_body'|trans }}
        </p>
    </div>
{% endblock %}

{% block footer %}
    <div class="modal-footer">
        <button type="button" class="btn-grey" data-action="click->modal#hide">{{ 'common.cancel'|trans }}</button>
        <form method="POST" action="{{ path('app_post_delete', {uuid: post.uuid}) }}" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-post-' ~ post.uuid) }}">
            <button type="submit" class="btn-danger">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
