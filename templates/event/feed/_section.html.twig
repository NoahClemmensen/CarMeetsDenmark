<section class="mt-6">
    <h2 class="text-lg font-semibold text-primary-text mb-3">{{ 'event.feed.title'|trans }}</h2>

    {% include 'event/feed/_composer.html.twig' with {event: event} only %}

    <div id="event-feed-posts-{{ event.uuid }}">
        {% if feedPosts is empty %}
            {% if is_granted('POST_TO_FEED', event) %}
                <p class="text-secondary-text text-sm text-center py-6">{{ 'event.feed.empty_can_post'|trans }}</p>
            {% else %}
                <p class="text-secondary-text text-sm text-center py-6">{{ 'event.feed.empty'|trans }}</p>
            {% endif %}
        {% else %}
            {% include 'event/feed/_posts_list.html.twig' with {
                event: event,
                posts: feedPosts,
                hypedPostIds: hypedPostIds,
                nextCursor: nextCursor,
            } only %}
        {% endif %}
    </div>
</section>
