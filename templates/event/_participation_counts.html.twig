<div id="event-counts-{{ event.uuid }}" class="text-sm">
    {% set total = participationCounts.going + participationCounts.maybe + participationCounts.declined %}
    {% if total == 0 %}
        <p class="text-secondary-text">No one's RSVP'd yet. Be the first.</p>
    {% else %}
        <p class="text-primary-text">
            <span class="font-semibold">{{ participationCounts.going }}</span>
            <span class="text-secondary-text">going</span>
            <span class="text-neutral-dark mx-1">·</span>
            <span class="font-semibold">{{ participationCounts.maybe }}</span>
            <span class="text-secondary-text">maybe</span>
            <span class="text-neutral-dark mx-1">·</span>
            <span class="font-semibold">{{ participationCounts.declined }}</span>
            <span class="text-secondary-text">can't go</span>
        </p>
    {% endif %}
</div>
