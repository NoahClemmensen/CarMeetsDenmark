{# Resolves the banner image URL for an event.
   Falls back to the stock image when no banner is set.
   Future: prefer host's banner before falling back to stock. #}
{% macro banner_url(event) %}
    {{- event and event.imageFilename
        ? asset('uploads/event-banners/' ~ event.imageFilename)
        : asset('stock-carmeet.jpg') -}}
{% endmacro %}

{# Compact event card used in the Discover feed and the My events lists.
   `goingCount` is the number of "Going" RSVPs (0 when omitted). #}
{% macro event_card(event, goingCount) %}
    {# Macros are isolated, so icons must be imported inside the macro body. #}
    {% import '_icons.html.twig' as icons %}
    {% set goingCount = goingCount|default(0) %}
    <a href="{{ path('app_event_show', {uuid: event.uuid}) }}" class="event-card">
        <div class="event-card__media">
            <img src="{{ _self.banner_url(event) }}" alt="" class="event-card__img" loading="lazy">
            {% if event.private %}
                <span class="event-card__badge">{{ 'event.members_only'|trans }}</span>
            {% endif %}
        </div>
        <div class="event-card__body">
            <h3 class="event-card__title">{{ event.name }}</h3>
            <div class="event-card__meta">
                <span class="event-card__date">
                    {{ event.startDate|date('M j · H:i', event.timezone ?: 'UTC') }}
                </span>
                {% if event.location %}
                    <span class="event-card__loc">
                        {{ icons.location({size: 14, class: 'shrink-0'}) }}
                        <span class="truncate">{{ event.location }}</span>
                    </span>
                {% endif %}
            </div>
            <div class="event-card__stats">
                <span class="event-card__stat event-card__stat--hype" title="{{ 'event.hype'|trans }}">
                    {{ icons.flame({size: 14}) }}{{ event.hypeCount }}
                </span>
                <span class="event-card__stat" title="{{ 'event.going'|trans }}">
                    {{ icons.person({size: 14}) }}{{ goingCount }}
                </span>
            </div>
        </div>
    </a>
{% endmacro %}
