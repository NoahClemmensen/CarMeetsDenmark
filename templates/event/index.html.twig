{% extends 'base.html.twig' %}
{% import 'event/_macros.html.twig' as eventMacros %}

{% block title %}{{ 'event.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="w-full max-w-5xl flex flex-col gap-8">
        {# === Attending === #}
        <section>
            <h2 class="text-2xl font-semibold mb-4">{{ 'event.index.attending'|trans }}</h2>

            {% if attendingEvents is empty %}
                <div class="card p-8 text-center text-secondary-text border border-neutral-dark">
                    {{ 'event.index.attending_empty'|trans }}
                    <a href="{{ path('app_discover') }}" class="text-primary font-medium hover:underline">{{ 'event.index.discover_some'|trans }}</a>
                </div>
            {% else %}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% for event in attendingEvents %}
                        {{ eventMacros.event_card(event, goingCounts[event.id]|default(0)) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {# === From your teams === #}
        <section>
            <h2 class="text-xl font-semibold mb-1">{{ 'event.index.from_teams'|trans }}</h2>
            <p class="text-sm text-secondary-text mt-0 mb-4">{{ 'event.index.from_teams_subtitle'|trans }}</p>

            {% if teamEvents is empty %}
                <div class="card p-8 text-center text-secondary-text border border-neutral-dark">
                    {{ 'event.index.teams_empty'|trans }}
                </div>
            {% else %}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% for event in teamEvents %}
                        {{ eventMacros.event_card(event, goingCounts[event.id]|default(0)) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
