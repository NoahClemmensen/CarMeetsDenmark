    'common.close': 'common.close'|trans,
    'common.dismiss': 'common.dismiss'|trans,
    'common.copied': 'common.copied'|trans,
    'auth.log_in': 'auth.log_in'|trans,
    'auth.sign_up': 'auth.sign_up'|trans,
    'heatmap.drop_pin': 'heatmap.drop_pin'|trans,
    'heatmap.pinned': 'heatmap.pinned'|trans,
    'heatmap.remove': 'heatmap.remove'|trans,
    'heatmap.active_in_area': 'heatmap.active_in_area'|trans,
    'heatmap.zoom_in_hint': 'heatmap.zoom_in_hint'|trans,
    'heatmap.refreshed_just_now': 'heatmap.refreshed_just_now'|trans,
    'heatmap.refreshed_seconds': 'heatmap.refreshed_seconds'|trans,
    'heatmap.refreshed_minutes': 'heatmap.refreshed_minutes'|trans,
    'heatmap.location_denied': 'heatmap.location_denied'|trans,
    'heatmap.rate_limit': 'heatmap.rate_limit'|trans,
    'heatmap.error': 'heatmap.error'|trans,
    'errors.content_load': 'errors.content_load'|trans,
    'errors.network': 'errors.network'|trans,
    'lightbox.previous': 'lightbox.previous'|trans,
    'lightbox.next': 'lightbox.next'|trans,
    'notification.load_error': 'notification.load_error'|trans,
