{% extends 'web/base.html.twig' %}

{% block title %}Set up your profile – CarMeetsDenmark{% endblock %}

{% block body %}
{% import 'web/_icons.html.twig' as icons %}
<style>
    @keyframes setup-fade-up {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .setup-animate {
        opacity: 0;
        animation: setup-fade-up 0.35s ease forwards;
    }
    .setup-animate:nth-child(1) { animation-delay: 0.05s; }
    .setup-animate:nth-child(2) { animation-delay: 0.12s; }
    .setup-animate:nth-child(3) { animation-delay: 0.19s; }
    .setup-animate:nth-child(4) { animation-delay: 0.26s; }
    .setup-animate:nth-child(5) { animation-delay: 0.33s; }

    .setup-section-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .accordion-trigger:hover { background-color: rgba(0,0,0,0.02); }
</style>

<div class="max-w-lg w-full">
    {{ form_start(form) }}

    {# ── Header ── #}
    <div class="setup-animate mb-6">
        <p class="setup-section-label text-primary mb-2">Welcome</p>
        <h1 class="text-2xl font-bold text-primary-text leading-tight mb-1">Set up your profile</h1>
        <p class="text-sm text-secondary-text">Takes less than a minute — most fields are optional.</p>
    </div>

    {# ── Card 1: The basics ── #}
    <div class="card p-6 mb-3 setup-animate">
        {{ form_row(form.name) }}

        <div class="mt-4">
            <label for="{{ form.description.vars.id }}" class="form-label flex items-center gap-2 mb-1">
                About you
                <span class="setup-optional-badge bg-neutral text-secondary-text">optional</span>
            </label>
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
    </div>

    {# ── Card 2: Socials + Creator role as accordions ── #}
    <div class="card overflow-hidden mb-5 setup-animate">

        {# Socials accordion #}
        <div data-controller="accordion">
            <button type="button"
                    data-action="click->accordion#toggle"
                    aria-expanded="false"
                    class="accordion-trigger w-full flex items-center justify-between px-6 py-4 text-left">
                <div>
                    <p class="setup-section-label text-secondary-text">Your socials</p>
                    <p class="text-xs text-secondary-text font-normal normal-case tracking-normal mt-0.5">Instagram, YouTube, Facebook, website</p>
                </div>
                <span data-accordion-target="icon" class="shrink-0">{{ icons.chevronDown({class: 'text-secondary-text', size: 16}) }}</span>
            </button>
            <div data-accordion-target="panel">
                <div class="px-6 pb-5 space-y-3">
                    {{ form_row(form.instagramUrl) }}
                    {{ form_row(form.youtubeUrl) }}
                    {{ form_row(form.facebookUrl) }}
                    {{ form_row(form.websiteUrl) }}
                </div>
            </div>
        </div>

        <div class="border-t border-neutral-dark opacity-40 mx-6"></div>

        {# Creator role accordion #}
        <div data-controller="accordion">
            <button type="button"
                    data-action="click->accordion#toggle"
                    aria-expanded="false"
                    class="accordion-trigger w-full flex items-center justify-between px-6 py-4 text-left">
                <div>
                    <p class="setup-section-label text-secondary-text">Are you a creator?</p>
                    <p class="text-xs text-secondary-text font-normal normal-case tracking-normal mt-0.5">Most people skip this</p>
                </div>
                <span data-accordion-target="icon" class="shrink-0">{{ icons.chevronDown({class: 'text-secondary-text', size: 16}) }}</span>
            </button>
            <div data-accordion-target="panel">
                <div class="px-6 pb-5">
                    <p class="text-xs text-secondary-text mb-3">Select only if you're actively working as a photographer or influencer.</p>
                    {{ form_widget(form.role) }}
                    {{ form_errors(form.role) }}
                </div>
            </div>
        </div>

    </div>

    {{ form_errors(form) }}

    {# ── Submit ── #}
    <div class="setup-animate">
        <button type="submit" class="btn-cta w-full justify-center">
            Let's go
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}

