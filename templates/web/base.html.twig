<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Car Meets Denmark{% endblock %}</title>
    <link rel="icon" href="{{ asset('logo.png') }}">

    {# Tailwind CSS for web platform #}
    <link rel="stylesheet" href="{{ asset('styles/web.css') }}">

    {# MapTiler SDK for map pages #}
{#    <link rel="stylesheet" href="https://cdn.maptiler.com/maptiler-sdk-js/v1.2.0/maptiler-sdk.css">#}

    {% block stylesheets %}{% endblock %}
    {% block head %}{% endblock %}
</head>
<body class="h-full bg-neutral-light text-primary-text font-inter" data-controller="turbo-error-handler">
{% import 'web/_icons.html.twig' as icons %}
{% if app.user %}
    <div class="app-layout">
        {# Sidebar #}
        <aside class="sidebar-card">
            <div class="sidebar-header">
                <a href="{{ path('web_home') }}" class="sidebar-logo">
                    <img src="{{ asset('maturix-nova-logo.svg') }}" alt="Carmeets Denmark">
                </a>
            </div>

            <nav class="sidebar-nav">
                {# Main navigation #}
                <div class="sidebar-section">
                    {% set isActive = app.request.attributes.get('_route') == 'web_home' %}
                    <a href="{{ path('web_home') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.dashboard() }}
                        <span>Home</span>
                    </a>
                    {% set isActive = app.request.attributes.get('_route') == 'app_event_index' %}
                    <a href="{{ path('app_event_index') }}"
                       class="sidebar-link {{ isActive ? 'active' : '' }}">
                        {{ icons.location() }}
                        <span>Events</span>
                    </a>
                </div>

                {% if is_support_mode() %}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Support</div>
                        {% set isActive = app.request.attributes.get('_route') == 'web_home' %}
                        <a href="{{ path('web_home') }}"
                           class="sidebar-link {{ isActive ? 'active' : '' }}">
                            {{ icons.dashboard() }}
                            <span>Pours</span>
                        </a>
                    </div>
                {% endif %}

                {# Spacer #}
                <div class="sidebar-spacer"></div>

                {# Bottom section #}
                <div class="sidebar-section">
                    <a href="{{ path('web_settings') }}" class="sidebar-link" data-turbo="false">
                        {{ icons.settings() }}
                        <span>Settings</span>
                    </a>
                    <a href="{{ path('web_logout') }}" class="sidebar-link" data-turbo="false">
                        {{ icons.logout() }}
                        <span>Logout</span>
                    </a>
                </div>
            </nav>
        </aside>

        {# Main content #}
        <div class="main-wrapper">
            <header class="topbar-card">
                <div class="topbar-content">
                    <div class="topbar-left">
                        {# Mobile menu button #}
                        <button type="button" class="mobile-menu-btn" onclick="toggleMobileMenu()"
                                aria-label="Open menu">
                            {{ icons.menu() }}
                        </button>
                        {# Support mode indicator #}
                        {% if is_support_mode() %}
                            <div class="support-mode-badge" role="status"
                                 aria-label="Support mode active - viewing all pours">
                                {{ icons.shield({size: 14}) }}
                                <span>
                                    Support
                                </span>
                            </div>
                        {% endif %}
                    </div>
                    <div class="topbar-right">
                        <div class="user-info">
                            <a href="{{ path('web_settings') }}" class="user-avatar">
                                {{ app.user.name|slice(0,1)|upper }}{{ app.user.name|split(' ')|last|slice(0,1)|upper }}
                            </a>
                            <div class="user-details">
                                <div class="user-name">{{ app.user.name }}</div>
                                <div class="user-email">{{ app.user.email }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <main class="content-card">
                {% for message in app.flashes('success') %}
                    <div class="alert-success" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert-error" role="alert">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    {# Mobile sidebar overlay #}
    <div class="mobile-overlay" id="mobile-overlay" onclick="toggleMobileMenu()"></div>

    <script>
        function toggleMobileMenu() {
            var sidebar = document.querySelector('.sidebar-card');
            var overlay = document.getElementById('mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.classList.toggle('mobile-menu-open');
            }
        }

        if (!window._sidebarListenersAttached) {
            window._sidebarListenersAttached = true;
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    var sidebar = document.querySelector('.sidebar-card');
                    if (sidebar && sidebar.classList.contains('mobile-open')) {
                        toggleMobileMenu();
                    }
                }
            });
        }
    </script>

    {# Toast container - persists through Turbo navigations #}
    <div id="toast-container" data-turbo-permanent></div>

    {# Modal shell - one per app, content swapped via Turbo Streams #}
    <twig:Modal:Shell/>
{% else %}
    {# Non-authenticated layout (login pages) #}
    <main class="min-h-full flex items-center justify-center py-12 px-4 bg-neutral">
        {{ block('body') }}
    </main>
{% endif %}

{% block javascripts %}
    {{ importmap('web') }}
{% endblock %}
</body>
</html>
