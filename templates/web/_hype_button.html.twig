{% import 'web/_icons.html.twig' as icons %}

{% set hypedClasses = 'bg-gradient-to-r from-orange-500 to-red-500 text-white border border-transparent ring-1 ring-red-400/30 shadow-[0_4px_12px_-2px_rgba(239,68,68,0.45)] hover:from-orange-600 hover:to-red-600 hover:shadow-[0_6px_16px_-2px_rgba(239,68,68,0.55)]' %}
{% set restClasses  = 'bg-white text-secondary-text border border-neutral-dark hover:text-orange-600 hover:border-orange-300 hover:bg-orange-50' %}
{% set baseClasses  = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-button text-xs font-semibold transition-all duration-200 select-none' %}

<span id="{{ targetId }}" class="inline-flex" title="{{ count }} hyped">
    {% if app.user %}
        <form method="POST" action="{{ formAction }}" class="contents">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenName) }}">
            <button type="submit"
                    aria-pressed="{{ isHyped ? 'true' : 'false' }}"
                    aria-label="{{ isHyped ? 'Remove hype' : 'Hype this' }}"
                    class="{{ baseClasses }} active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400/60 {{ isHyped ? hypedClasses : restClasses }}">
                {{ icons.flame({size: 12, class: isHyped ? 'drop-shadow-[0_0_4px_rgba(255,255,255,0.55)]' : ''}) }}
                <span class="tabular-nums {{ isHyped ? 'font-bold' : '' }}">{{ count }}</span>
            </button>
        </form>
    {% else %}
        <span class="{{ baseClasses }} {{ isHyped ? hypedClasses : restClasses }}" title="Log in to hype">
            {{ icons.flame({size: 12, class: isHyped ? 'drop-shadow-[0_0_4px_rgba(255,255,255,0.55)]' : ''}) }}
            <span class="tabular-nums {{ isHyped ? 'font-bold' : '' }}">{{ count }}</span>
        </span>
    {% endif %}
</span>
