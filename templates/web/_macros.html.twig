{#
Macros shared across web templates.
Import as: {% import 'web/_macros.html.twig' as macros %}
#}

{#
Phone formatter.
- Both phoneNumber and countryCode present: "+{countryCode} {phoneNumber}"
- phoneNumber only:                          "{phoneNumber}" (no leading "+")
- phoneNumber null/blank:                    "" (caller decides fallback)
#}
{% macro phone(user) %}
    {%- if user.phoneNumber -%}
        {%- if user.countryCode -%}
            +{{ user.countryCode }} {{ user.phoneNumber }}
        {%- else -%}
            {{ user.phoneNumber }}
        {%- endif -%}
    {%- endif -%}
{% endmacro %}
