{% extends 'web/base.html.twig' %}
{% import 'web/event/_macros.html.twig' as eventMacros %}

{% block title %}{{ event.name }} - CMD{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div class="w-full max-w-md">
        <div class="card p-8">
            <img src="{{ eventMacros.banner_url(event) }}"
                 alt="{{ event.name }}"
                 class="rounded-container mb-4 w-full object-cover">
            <h1 class="text-xl font-bold text-primary-text mb-2">{{ event.name }}</h1>
            <p class="text-secondary-text">{{ event.description }}</p>
        </div>
    </div>
{% endblock %}
