{% extends 'web/base.html.twig' %}
{% import 'web/event/_macros.html.twig' as eventMacros %}
{% import 'web/_icons.html.twig' as icons %}

{% block title %}{{ event ? 'Edit event' : 'New event' }} – CMD{% endblock %}

{% block header %}{% endblock %}

{% block body %}
<style>
    .setup-section-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .accordion-trigger:hover { background-color: rgba(0,0,0,0.02); }
</style>

    <div class="w-full max-w-lg">
        {{ form_start(form) }}

        <h1 class="text-2xl font-bold text-primary-text mb-4">
            {{ event ? 'Edit event' : 'New event' }}
        </h1>

        {% set hasSavedBanner = event and event.imageFilename %}
        <div class="event-banner-editor mb-4"
             data-controller="event-banner-editor"
             data-has-saved-banner="{{ hasSavedBanner ? 'true' : 'false' }}">
            <img data-event-banner-editor-target="image"
                 src="{{ eventMacros.banner_url(event) }}"
                 alt="{{ event ? event.name : 'Banner preview' }}"
                 class="event-banner-editor__image">

            <div class="event-banner-editor__overlay">
                <label for="{{ form.imageFile.vars.id }}" class="event-banner-editor__btn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-3.5 h-3.5">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <span>Change</span>
                </label>

                <button type="button"
                        data-action="click->event-banner-editor#remove"
                        data-event-banner-editor-target="removeBtn"
                        class="event-banner-editor__btn{% if not hasSavedBanner %} hidden{% endif %}">
                    {{ icons.trashcan({size: 14}) }}
                    <span>Remove</span>
                </button>
            </div>

            <div class="event-banner-editor__inputs">
                {{ form_widget(form.imageFile, {
                    attr: {
                        'data-event-banner-editor-target': 'fileInput',
                        'data-action': 'change->event-banner-editor#previewFile',
                        'accept': 'image/jpeg,image/png,image/gif,image/webp',
                    }
                }) }}
                {{ form_widget(form.removeImage, {
                    attr: {
                        'data-event-banner-editor-target': 'removeCheckbox',
                    }
                }) }}
            </div>
        </div>

        {{ form_errors(form.imageFile) }}

        <div class="card p-6 mb-3">
            {{ form_row(form.name) }}

            <div class="mt-4">
                <label for="{{ form.description.vars.id }}" class="form-label flex items-center gap-2 mb-1">
                    Description
                    <span class="setup-optional-badge bg-neutral text-secondary-text">optional</span>
                </label>
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="card p-6 mb-3">
            {{ form_row(form.startDate) }}
            <div class="mt-4">
                {{ form_row(form.location) }}
            </div>
            <div class="mt-4">
                {{ form_row(form.private) }}
            </div>
        </div>

        <div class="card overflow-hidden mb-5">

            {# Repeats #}
            <div data-controller="accordion">
                <button type="button"
                        data-action="click->accordion#toggle"
                        aria-expanded="false"
                        class="accordion-trigger w-full flex items-center justify-between px-6 py-4 text-left">
                    <p class="setup-section-label text-secondary-text">Repeats</p>
                    <span data-accordion-target="icon" class="shrink-0">{{ icons.chevronDown({class: 'text-secondary-text', size: 16}) }}</span>
                </button>
                <div data-accordion-target="panel">
                    <div class="px-6 pt-2 pb-5">
                        <div class="flex items-end gap-3">
                            <div class="w-24">
                                {{ form_row(form.repeatAmount) }}
                            </div>
                            <div class="flex-1">
                                {{ form_row(form.repeatFrequency) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-neutral-dark opacity-40 mx-6"></div>

            {# Ends #}
            <div data-controller="accordion">
                <button type="button"
                        data-action="click->accordion#toggle"
                        aria-expanded="false"
                        class="accordion-trigger w-full flex items-center justify-between px-6 py-4 text-left">
                    <p class="setup-section-label text-secondary-text">Ends</p>
                    <span data-accordion-target="icon" class="shrink-0">{{ icons.chevronDown({class: 'text-secondary-text', size: 16}) }}</span>
                </button>
                <div data-accordion-target="panel">
                    <div class="px-6 pt-2 pb-5">
                        {{ form_widget(form.endDate) }}
                        {{ form_errors(form.endDate) }}
                    </div>
                </div>
            </div>

            <div class="border-t border-neutral-dark opacity-40 mx-6"></div>

            {# Timezone #}
            <div data-controller="accordion">
                <button type="button"
                        data-action="click->accordion#toggle"
                        aria-expanded="false"
                        class="accordion-trigger w-full flex items-center justify-between px-6 py-4 text-left">
                    <p class="setup-section-label text-secondary-text">Timezone</p>
                    <span data-accordion-target="icon" class="shrink-0">{{ icons.chevronDown({class: 'text-secondary-text', size: 16}) }}</span>
                </button>
                <div data-accordion-target="panel">
                    <div class="px-6 pt-2 pb-5">
                        {{ form_widget(form.timezone) }}
                        {{ form_errors(form.timezone) }}
                    </div>
                </div>
            </div>

        </div>

        {{ form_errors(form) }}

        <button type="submit" class="btn-cta w-full justify-center">
            {{ event ? 'Save changes' : 'Create event' }}
        </button>

        {{ form_widget(form._token) }}
        {{ form_end(form, {render_rest: false}) }}

        {% if event and is_granted('DELETE', event) %}
            <button type="button"
                    class="btn-text text-error hover:bg-error-container w-full justify-center mt-4"
                    data-controller="modal-trigger"
                    data-action="click->modal-trigger#open"
                    data-modal-trigger-url-value="{{ path('app_event_delete_confirm', {uuid: event.uuid}) }}">
                Delete event
            </button>
        {% endif %}
    </div>
{% endblock %}
