{% import 'web/_icons.html.twig' as icons %}

<span id="event-hype-{{ event.uuid }}"
      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-button bg-gradient-to-r from-orange-100 to-red-100 text-red-600 text-xs font-semibold"
      title="{{ event.interest }} interested">
    {{ icons.flame({size: 12}) }}
    <span>{{ event.interest }}</span>
</span>
