{% extends 'components/Modal/ContentShell.html.twig' %}

{% block header %}
    <twig:Modal:Header title="Change password" />
{% endblock %}

{% block body %}
    <div class="px-6 py-4">
        {{ form_start(passwordForm, {
            action: path('app_settings_password'),
            attr: {'data-turbo': 'true', id: 'change-password-form'},
        }) }}
            <div class="space-y-3">
                {{ form_row(passwordForm.currentPassword) }}
                {{ form_row(passwordForm.newPassword.first) }}
                {{ form_row(passwordForm.newPassword.second) }}
            </div>
            {{ form_errors(passwordForm) }}
        {{ form_end(passwordForm) }}
    </div>
{% endblock %}

{% block footer %}
    <div class="modal-footer">
        <button type="button" class="btn-grey" data-action="click->modal#hide">Cancel</button>
        <button type="submit" form="change-password-form" class="btn-primary">Update password</button>
    </div>
{% endblock %}
